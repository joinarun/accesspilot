# AccessPilot local configuration. Copy to .env; never commit real values.
ACCESSPILOT_LLM_PROVIDER=gemini
ACCESSPILOT_GEMINI_MODEL=gemini-2.5-pro
ACCESSPILOT_OPENAI_MODEL=gpt-4.1
ACCESSPILOT_WORKSPACE_ROOT=.accesspilot/workspaces
ACCESSPILOT_ARTIFACT_ROOT=.accesspilot/artifacts
ACCESSPILOT_MAX_REPAIR_ROUNDS=3
ACCESSPILOT_COMMAND_TIMEOUT_SECONDS=180

# Gemini via Google AI Studio. GOOGLE_API_KEY is also supported by the SDK.
GEMINI_API_KEY=

# Or Vertex AI for Gemini:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# OpenAI-compatible models MUST go through the enterprise LLMproxy.
# Direct public OpenAI endpoints are rejected by the provider factory.
LLMPROXY_BASE_URL=
LLMPROXY_API_KEY=

# High-risk capabilities are disabled by server policy unless explicitly enabled.
ACCESSPILOT_ENABLE_LOCAL_EXECUTION=false
ACCESSPILOT_ENABLE_DEPENDENCY_INSTALL=false
ACCESSPILOT_ENABLE_REMOTE_MUTATIONS=false
ACCESSPILOT_ALLOW_REMOTE_CLIENTS=false
ACCESSPILOT_ALLOW_PRIVATE_NETWORK_TARGETS=false
# Separate multiple allowed local source roots with the platform path separator.
ACCESSPILOT_ALLOWED_SOURCE_ROOTS=

# Optional GitHub CLI authentication should be supplied to `gh` externally.
# GH_TOKEN=replace-at-runtime
